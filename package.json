{
  "name": "work-encourager",
  "version": "1.1.0",
  "private": true,
  "description": "上班鼓励器 · Electron 与 Tauri 双版本，共享同一套计算引擎",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:electron": "pnpm --filter @we/electron dev",
    "dev:tauri": "pnpm --filter @we/tauri dev",
    "package:electron": "pnpm --filter @we/electron package:win",
    "package:tauri": "pnpm --filter @we/tauri build"
  }
}
