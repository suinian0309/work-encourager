{
  "name": "@we/tauri",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "上班鼓励器 Tauri 版",
  "scripts": {
    "dev:web": "vite --port 5173 --strictPort",
    "build:web": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:gnu": "tauri build --target x86_64-pc-windows-gnu",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "decimal.js": "10.6.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7",
    "vue-tsc": "3.1.1"
  }
}
